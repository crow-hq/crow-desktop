# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only these emails may sign in (comma separated). Everyone else is turned away.
ALLOWED_EMAILS=you@example.com

# OpenRouter: https://openrouter.ai/keys . Server-side only, never sent to the browser.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: the public URL of the app, sent to OpenRouter as the referer.
APP_URL=https://your-app.vercel.app
